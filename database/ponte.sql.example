-- Modelo temporário da base de dados ConsultaTaxasPontes.
-- Copie este arquivo para database/ponte.sql e insira os registros autorizados.
-- Não coloque dados corporativos neste repositório público.
-- O aplicativo reconstrói data/ponte.db a partir deste script ao iniciar.

CREATE TABLE obras (
    id INTEGER PRIMARY KEY,
    obra INTEGER NOT NULL,
    tipo_obra TEXT,
    largura_m REAL,
    vao_min_m REAL,
    vao_max_m REAL,
    secao TEXT,
    hviga_laje_m TEXT,
    compr_obra_m REAL,
    em_m3_m2 REAL,
    Paf_kg_m2 REAL,
    Pap_kg_m2 REAL,
    Af_m2_m2 REAL,
    anc_at_pas REAL
);

CREATE INDEX idx_obras_tipo ON obras(tipo_obra);
CREATE INDEX idx_obras_largura ON obras(largura_m);

